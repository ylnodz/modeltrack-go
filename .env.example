# ╔══════════════════════════════════════════════════════════╗
# ║  ModelTrack Go — configuration                            ║
# ║  Only Discord is required. Every provider key is optional.║
# ╚══════════════════════════════════════════════════════════╝

# ── Discord (required) ──────────────────────────────────────
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
# Optional: instant slash-command sync in one guild (Snowflake ID)
DISCORD_GUILD_ID=
# Optional: prefix became-free notices with @here
ANNOUNCE_MENTION=false

# ── Runtime ─────────────────────────────────────────────────
PORT=8000
DB_PATH=/home/container/modeltrack.db
TRACK_INTERVAL_MINUTES=30
PROVIDER_TIMEOUT_SECONDS=25
LOG_LEVEL=INFO

# ── Providers (all optional; unset = skipped) ───────────────
# OpenRouter's /models endpoint is public — a key only raises rate limits.
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
OLLAMA_CLOUD_BASE_URL=https://ollama.com
OLLAMA_CLOUD_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
HUGGINGFACE_API_KEY=
SILICONFLOW_API_KEY=
ZAI_API_KEY=
COHERE_API_KEY=
SAMBANOVA_API_KEY=
CHUTES_API_KEY=
NEBIUS_API_KEY=
